{
  "name": "replay-york-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node cms/build.mjs && npm run build:admin",
    "build:admin": "cd studio && sanity build ../dist/admin && node ../cms/admin-meta.mjs",
    "check": "node --check cms/build.mjs && node --check dist/script.js",
    "studio": "cd studio && sanity dev --host 127.0.0.1",
    "test": "node --test cms/build.test.mjs"
  },
  "dependencies": {
    "sanity": "6.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "^6.1.15",
    "cheerio": "1.2.0"
  }
}
