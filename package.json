{
  "name": "replay-york-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:admin && next build && node cms/prepare-standalone.mjs",
    "build:admin": "cd studio && sanity build ../public/admin && node ../cms/admin-meta.mjs",
    "check": "node --check lib/site-effects.js && tsc --noEmit",
    "studio": "cd studio && sanity dev --host 127.0.0.1",
    "test": "node --test cms/build.test.mjs",
    "build:static": "node cms/build.mjs && cd studio && sanity build ../dist/admin",
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test:web": "node --test cms/next.test.mjs"
  },
  "dependencies": {
    "sanity": "6.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "^6.1.15",
    "cheerio": "1.2.0",
    "next": "16.4.4",
    "next-sanity": "^13.1.5",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "js-yaml@^3.0.0": "3.15.2",
    "smol-toml@^1.0.0": "1.9.1",
    "undici@^7.0.0": "7.30.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.0"
  }
}
